# {{ ansible_managed }}
# Survives package upgrades of the vendor unit file.
[Unit]
{% if mongodb_systemd_unit_after | length > 0 %}
After={{ mongodb_systemd_unit_after }}
{% endif %}
{% if mongodb_systemd_unit_wants | length > 0 %}
Wants={{ mongodb_systemd_unit_wants }}
{% endif %}
{% if mongodb_systemd_unit_requires_mounts_for | length > 0 %}
RequiresMountsFor={{ mongodb_systemd_unit_requires_mounts_for }}
{% endif %}

[Service]
# StartLimit* live in [Service] under their legacy names because systemd 219 (EL 7,
# Amazon Linux 2) ignores them in [Unit]. Newer systemd still reads them here.
{% if mongodb_systemd_unit_start_limit_burst | string | length > 0 %}
StartLimitBurst={{ mongodb_systemd_unit_start_limit_burst }}
{% endif %}
{% if mongodb_systemd_unit_start_limit_interval_sec | string | length > 0 %}
StartLimitInterval={{ mongodb_systemd_unit_start_limit_interval_sec }}
{% endif %}
{% if mongodb_systemd_unit_restart | length > 0 %}
Restart={{ mongodb_systemd_unit_restart }}
{% endif %}
{% if mongodb_systemd_unit_restart_sec | string | length > 0 %}
RestartSec={{ mongodb_systemd_unit_restart_sec }}
{% endif %}
{% if mongodb_systemd_unit_timeout_start_sec | string | length > 0 %}
TimeoutStartSec={{ mongodb_systemd_unit_timeout_start_sec }}
{% endif %}
{% if mongodb_systemd_unit_timeout_stop_sec | string | length > 0 %}
TimeoutStopSec={{ mongodb_systemd_unit_timeout_stop_sec }}
{% endif %}
{% if mongodb_systemd_unit_kill_mode | length > 0 %}
KillMode={{ mongodb_systemd_unit_kill_mode }}
{% endif %}
{% if mongodb_systemd_unit_kill_signal | length > 0 %}
KillSignal={{ mongodb_systemd_unit_kill_signal }}
{% endif %}
